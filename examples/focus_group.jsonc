CREATE TABLE user_sequence (
    user_id BIGINT PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    to_learn_words TEXT NOT NULL DEFAULT '', -- en;ru;word -- src_lang;dst_lang;word

    last_gen_id INT NOT NULL DEFAULT 0,
    last_update_id INT NOT NULL DEFAULT 0,
    last_gen_time INT NOT NULL DEFAULT 0,

    focus_group_size INT NOT NULL DEFAULT 3,
    focus_group JSONB NOT NULL DEFAULT '{}',
    focus_group_id INT NOT NULL DEFAULT 0,
    focus_group_last_update_time INT NOT NULL DEFAULT 0
) PARTITION BY HASH (user_id);

ci: current_item
d: data
    t: type [l: learn, ru: rate_us]
    sl: src_lang
    s: src_placeholder
    sa: src_array
    d: dst_placeholder
    da: dst_array
    v2: variants_second
    v3: variants_third
    p: progress
        m: mistakes
        sa: seconds_spent_on_answer
        sn: seconds_spent_till_next

